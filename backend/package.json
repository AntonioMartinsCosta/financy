{
  "name": "@financy/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "pnpm build && node dist/seed.js",
    "test": "pnpm build && node --test test/api.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "prisma": "6.19.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "tsx": "^4.20.5",
    "@types/node": "^24.5.2",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
